		{
			"id": "annotation-1-text",
			"type": "text",
			"x": 650,
			"y": 110,
			"width": 260,
			"height": 80,
			"text": "Actors provide thread-safe isolation.\nOnly one task can access actor state\nat a time. Access from outside requires\n'await' to suspend until the actor is free.\nNo manual locking needed.",
			"fontSize": 11,
			"fontFamily": 2,
			"textAlign": "left",
			"roughness": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"opacity": 100,
			"angle": 0,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"locked": false
		},
