		{
			"id": "Ay1DnwQs",
			"type": "text",
			"x": 227.54339200709597,
			"y": 666.7358627580783,
			"width": 187.0859375,
			"height": 88.54999999999998,
			"text": "Audio callbacks run on background\nthreads owned by the OS frameworks.\nTo safely update shared state:\n• Use actors (automatic isolation)\n• Use NSLock (manual locking)\n• Use Task { @MainActor in ... }\n  to hop to main thread",
			"fontSize": 11,
			"fontFamily": 2,
			"textAlign": "left",
			"roughness": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"opacity": 100,
			"angle": 0,
			"groupIds": [
				"cOinL5mYFSxUCTjMBJNBa"
			],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"locked": false,
			"containerId": null,
			"originalText": "Audio callbacks run on background\nthreads owned by the OS frameworks.\nTo safely update shared state:\n• Use actors (automatic isolation)\n• Use NSLock (manual locking)\n• Use Task { @MainActor in ... }\n  to hop to main thread",
			"autoResize": true,
			"lineHeight": 1.15,
			"version": 171,
			"versionNonce": 1743818164,
			"index": "am",
			"isDeleted": false,
