			"roundness": null,
			"boundElements": [],
			"locked": false,
			"containerId": null,
			"originalText": "Hopping to Main Thread",
			"autoResize": true,
			"lineHeight": 1.15,
			"version": 1,
			"versionNonce": 1,
			"index": "b07",
			"isDeleted": false,
			"seed": 1,
