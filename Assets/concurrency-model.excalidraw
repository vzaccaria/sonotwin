			"type": "text",
			"x": 679.863538,
			"y": 479.884846,
			"width": 191.1787109375,
			"height": 50.599999999999994,
			"text": "Obj-C pattern: object A tells object B\n\"call me when X happens\". Protocols\ndefine the callback methods. Used by\nAVCaptureSession, NSApplication, etc.",
			"fontSize": 11,
			"fontFamily": 2,
			"textAlign": "left",
			"roughness": 0,
			"strokeColor": "#1e1e1e",
