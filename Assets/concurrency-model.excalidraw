			"boundElements": [],
			"locked": false,
			"containerId": null,
			"originalText": "Thread Safety",
			"autoResize": true,
			"lineHeight": 1.15,
			"version": 171,
			"versionNonce": 935146548,
			"index": "al",
			"isDeleted": false,
