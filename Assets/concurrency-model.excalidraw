			"text": "Actors provide thread-safe isolation.\nOnly one task can access actor state\nat a time. Access from outside requires\n'await' to suspend until the actor is free.\nNo manual locking needed.",
			"fontSize": 11,
			"fontFamily": 2,
			"textAlign": "left",
			"roughness": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"opacity": 100,
			"angle": 0,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"locked": false,
			"containerId": null,
			"originalText": "Actors provide thread-safe isolation.\nOnly one task can access actor state\nat a time. Access from outside requires\n'await' to suspend until the actor is free.\nNo manual locking needed.",
			"autoResize": true,
			"lineHeight": 1.15,
