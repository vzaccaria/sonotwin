		},
		{
			"id": "hopping-text",
			"type": "text",
			"x": -271,
			"y": 240,
			"width": 260,
			"height": 151,
			"text": "Only the main thread can update UI.\nAudio callbacks run on background threads.\n\nTo safely update UI state from a callback:\n\n  Task { @MainActor in\n      state.level = newValue\n  }\n\n1. Background thread creates the Task\n2. Swift schedules it on main thread's queue\n3. Background thread continues (doesn't wait)\n4. Main thread executes it when free",
			"fontSize": 11,
			"fontFamily": 2,
			"textAlign": "left",
			"roughness": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"opacity": 100,
			"angle": 0,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"locked": false,
			"containerId": null,
			"originalText": "Only the main thread can update UI.\nAudio callbacks run on background threads.\n\nTo safely update UI state from a callback:\n\n  Task { @MainActor in\n      state.level = newValue\n  }\n\n1. Background thread creates the Task\n2. Swift schedules it on main thread's queue\n3. Background thread continues (doesn't wait)\n4. Main thread executes it when free",
			"autoResize": true,
			"lineHeight": 1.15,
			"version": 1,
			"versionNonce": 1,
			"index": "b08",
			"isDeleted": false,
			"seed": 1,
			"updated": 1771439500000,
